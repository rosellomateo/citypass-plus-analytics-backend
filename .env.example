# HTML embed: release publicada por el pipeline del frontend. SHA completo de 40 caracteres.
EMBED_STORAGE_ACCOUNT_URL=https://citypassstorage.blob.core.windows.net
EMBED_STORAGE_CONTAINER=plantillas
EMBED_RELEASE_SHA=
EMBED_CACHE_TTL_SEGUNDOS=600
# Solo si el backend usa una identidad administrada asignada por el usuario.
EMBED_MANAGED_IDENTITY_CLIENT_ID=
